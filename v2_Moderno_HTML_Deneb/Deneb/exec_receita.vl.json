{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "data": {
    "name": "dataset"
  },
  "width": "container",
  "height": "container",
  "encoding": {
    "x": {
      "field": "mes",
      "type": "ordinal",
      "sort": {
        "field": "ord"
      },
      "axis": {
        "title": null,
        "labelAngle": 0,
        "labelOverlap": true
      }
    }
  },
  "layer": [
    {
      "mark": {
        "type": "bar",
        "cornerRadiusTopLeft": 4,
        "cornerRadiusTopRight": 4,
        "width": {
          "band": 0.68
        }
      },
      "encoding": {
        "y": {
          "field": "receita",
          "type": "quantitative",
          "axis": {
            "title": null,
            "labelExpr": "format(datum.value / 1000000, ',.1f') + ' mi'",
            "tickCount": 5
          }
        },
        "color": {
          "field": "cor",
          "type": "nominal",
          "scale": null
        },
        "tooltip": [
          {
            "field": "mes",
            "title": "Mês"
          },
          {
            "field": "receita",
            "title": "Receita líquida",
            "format": ",.0f"
          },
          {
            "field": "ly",
            "title": "Ano anterior",
            "format": ",.0f"
          },
          {
            "field": "meta",
            "title": "Meta",
            "format": ",.0f"
          }
        ]
      }
    },
    {
      "mark": {
        "type": "line",
        "strokeDash": [
          5,
          4
        ],
        "color": "#EF9277",
        "strokeWidth": 2
      },
      "encoding": {
        "y": {
          "field": "meta",
          "type": "quantitative"
        }
      }
    },
    {
      "mark": {
        "type": "line",
        "color": "#DDF5EB",
        "strokeWidth": 2,
        "opacity": 0.8,
        "point": {
          "filled": true,
          "size": 26,
          "color": "#DDF5EB"
        }
      },
      "encoding": {
        "y": {
          "field": "ly",
          "type": "quantitative"
        }
      }
    }
  ]
}