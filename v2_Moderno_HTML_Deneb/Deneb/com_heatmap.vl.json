{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "data": {
    "name": "dataset"
  },
  "width": "container",
  "height": "container",
  "mark": {
    "type": "rect",
    "cornerRadius": 3,
    "stroke": "#071E23",
    "strokeWidth": 2
  },
  "encoding": {
    "x": {
      "field": "mes",
      "type": "ordinal",
      "sort": {
        "field": "ord",
        "op": "min",
        "order": "ascending"
      },
      "axis": {
        "title": null,
        "labelAngle": 0,
        "labelOverlap": true
      }
    },
    "y": {
      "field": "dia",
      "type": "ordinal",
      "sort": {
        "field": "dord",
        "op": "min",
        "order": "ascending"
      },
      "axis": {
        "title": null
      }
    },
    "color": {
      "field": "cupons",
      "type": "quantitative",
      "scale": {
        "range": [
          "#0E3138",
          "#125F61",
          "#18B89F",
          "#DDF5EB"
        ]
      },
      "legend": {
        "title": "Cupons",
        "orient": "right",
        "gradientLength": 160
      }
    },
    "tooltip": [
      {
        "field": "mes",
        "title": "Mês"
      },
      {
        "field": "dia",
        "title": "Dia"
      },
      {
        "field": "cupons",
        "title": "Cupons",
        "format": ",.0f"
      }
    ]
  }
}