{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "data": {
    "name": "dataset"
  },
  "width": "container",
  "height": "container",
  "transform": [
    {
      "window": [
        {
          "op": "sum",
          "field": "rec",
          "as": "acc"
        }
      ],
      "sort": [
        {
          "field": "rec",
          "order": "descending"
        }
      ],
      "frame": [
        null,
        0
      ]
    },
    {
      "joinaggregate": [
        {
          "op": "sum",
          "field": "rec",
          "as": "tot"
        }
      ]
    },
    {
      "calculate": "datum.acc / datum.tot",
      "as": "pct"
    },
    {
      "calculate": "datum.pct - datum.rec / datum.tot < 0.8 ? 'A (até 80%)' : 'B/C'",
      "as": "classe"
    }
  ],
  "encoding": {
    "x": {
      "field": "sub",
      "type": "nominal",
      "sort": "-y",
      "axis": {
        "title": null,
        "labelAngle": -40,
        "labelLimit": 90
      }
    }
  },
  "layer": [
    {
      "mark": {
        "type": "bar",
        "cornerRadiusTopLeft": 3,
        "cornerRadiusTopRight": 3
      },
      "encoding": {
        "y": {
          "field": "rec",
          "type": "quantitative",
          "axis": {
            "title": null,
            "labelExpr": "format(datum.value / 1000000, ',.1f') + ' mi'"
          }
        },
        "color": {
          "field": "classe",
          "type": "nominal",
          "scale": {
            "domain": [
              "A (até 80%)",
              "B/C"
            ],
            "range": [
              "#18B89F",
              "#3D6E72"
            ]
          },
          "legend": {
            "title": null
          }
        },
        "tooltip": [
          {
            "field": "sub",
            "title": "Subcategoria"
          },
          {
            "field": "rec",
            "title": "Receita",
            "format": ",.0f"
          },
          {
            "field": "pct",
            "title": "% acumulado",
            "format": ".1%"
          }
        ]
      }
    },
    {
      "mark": {
        "type": "line",
        "color": "#EF9277",
        "strokeWidth": 2,
        "point": {
          "color": "#EF9277",
          "size": 22
        }
      },
      "encoding": {
        "x": {
          "field": "sub",
          "type": "nominal",
          "sort": {
            "field": "rec",
            "order": "descending"
          }
        },
        "y": {
          "field": "pct",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              1
            ]
          },
          "axis": {
            "title": null,
            "format": ".0%",
            "orient": "right",
            "grid": false
          }
        }
      }
    },
    {
      "mark": {
        "type": "rule",
        "color": "#F2C46D",
        "strokeDash": [
          3,
          3
        ]
      },
      "encoding": {
        "y": {
          "datum": 0.8,
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              1
            ]
          },
          "axis": null
        }
      }
    }
  ],
  "resolve": {
    "scale": {
      "y": "independent"
    }
  }
}