{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "data": {
    "name": "dataset"
  },
  "width": "container",
  "height": "container",
  "encoding": {
    "x": {
      "field": "mes",
      "type": "ordinal",
      "sort": {
        "field": "ord",
        "op": "min",
        "order": "ascending"
      },
      "axis": {
        "title": null,
        "labelAngle": 0,
        "labelOverlap": true
      }
    }
  },
  "layer": [
    {
      "mark": {
        "type": "area",
        "color": "#18B89F",
        "opacity": 0.18
      },
      "encoding": {
        "y": {
          "field": "lo",
          "type": "quantitative"
        },
        "y2": {
          "field": "hi"
        }
      }
    },
    {
      "mark": {
        "type": "line",
        "color": "#DDF5EB",
        "strokeWidth": 2.5,
        "point": {
          "filled": true,
          "size": 24,
          "color": "#DDF5EB"
        }
      },
      "encoding": {
        "y": {
          "field": "real",
          "type": "quantitative",
          "axis": {
            "title": null,
            "labelExpr": "format(datum.value / 1000000, ',.1f') + ' mi'"
          },
          "scale": {
            "zero": false
          }
        }
      }
    },
    {
      "mark": {
        "type": "line",
        "color": "#18B89F",
        "strokeWidth": 3,
        "strokeDash": [
          6,
          4
        ],
        "point": {
          "filled": true,
          "size": 34,
          "color": "#18B89F"
        }
      },
      "encoding": {
        "y": {
          "field": "prev",
          "type": "quantitative"
        },
        "tooltip": [
          {
            "field": "mes",
            "title": "Mês"
          },
          {
            "field": "prev",
            "title": "Previsto",
            "format": ",.0f"
          },
          {
            "field": "lo",
            "title": "Limite inferior",
            "format": ",.0f"
          },
          {
            "field": "hi",
            "title": "Limite superior",
            "format": ",.0f"
          }
        ]
      }
    },
    {
      "mark": {
        "type": "point",
        "opacity": 0
      },
      "encoding": {
        "y": {
          "field": "real",
          "type": "quantitative"
        },
        "tooltip": [
          {
            "field": "mes",
            "title": "Mês"
          },
          {
            "field": "real",
            "title": "Realizado",
            "format": ",.0f"
          }
        ]
      }
    }
  ]
}