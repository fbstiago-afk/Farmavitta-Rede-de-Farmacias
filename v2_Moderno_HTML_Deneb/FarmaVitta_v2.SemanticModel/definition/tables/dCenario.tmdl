	partition dCenario = m
		mode: import
		source =
				let
				    Fonte = fnCsv("01_Dados_Originais\base_complementar\d_cenarios_previsao.csv"),
				    Tipado = Table.TransformColumnTypes(Fonte, {{"id_cenario", type text}, {"cenario", type text}, {"fator_receita", type number}, {"fator_custo", type number}, {"descricao", type text}}, "en-US"),
				    Ultimo = Tipado,
				    Final = Table.SelectColumns(Ultimo, {"id_cenario", "cenario", "fator_receita", "fator_custo", "descricao"})
				in
				    Final

	annotation PBI_ResultType = Table
