	column 'Classe ABC'
		dataType: string
		lineageTag: 0dfc9580-e4e6-5a0d-baca-db6fdb9a8d05
		summarizeBy: none
		sourceColumn: classe_abc

		annotation SummarizationSetBy = Automatic

	column 'Rank Receita'
		dataType: int64
		lineageTag: f253710e-edd1-5cfb-a18e-de3c32a670cf
		summarizeBy: none
		sourceColumn: rank_receita

		annotation SummarizationSetBy = Automatic

	partition dProduto = m
		mode: import
		source =
				let
				    Fonte = fnCsv("01_Dados_Originais\base_original\dim_produtos.csv"),
				    Tipado = Table.TransformColumnTypes(Fonte, {{"preco_lista_referencia", type number}, {"custo_unitario_referencia", type number}}, "en-US"),
				    SimNao = Table.TransformColumns(Tipado, {{"eh_generico", each if _ = "1" then "Sim" else "Não", type text}, {"eh_controlado", each if _ = "1" then "Sim" else "Não", type text}, {"exige_receita", each if _ = "1" then "Sim" else "Não", type text}}),
				    Ponte = fnCsv("01_Dados_Originais\base_original\ponte_produto_fornecedor.csv"),
				    J1 = Table.NestedJoin(SimNao, "id_produto", Ponte, "id_produto", "p", JoinKind.LeftOuter),
				    E1 = Table.ExpandTableColumn(J1, "p", {"id_fornecedor"}),
				    Abc = Table.TransformColumnTypes(fnCsv("02_Dados_Tratados\d_produto_abc.csv"), {{"rank_receita", Int64.Type}}, "en-US"),
				    J2 = Table.NestedJoin(E1, "id_produto", Abc, "id_produto", "a", JoinKind.LeftOuter),
				    E2 = Table.ExpandTableColumn(J2, "a", {"classe_abc", "rank_receita"}),
				    Final = Table.SelectColumns(E2, {"id_produto", "nome_produto", "categoria", "subcategoria", "marca", "preco_lista_referencia", "custo_unitario_referencia", "eh_generico", "eh_controlado", "exige_receita", "status", "id_fornecedor", "classe_abc", "rank_receita"})
				in
				    Final

	annotation PBI_ResultType = Table
