		dataType: string
		lineageTag: 57421267-661c-59df-9c63-23daaf7405a6
		summarizeBy: none
		sourceColumn: subcategoria

		annotation SummarizationSetBy = Automatic

	column Marca
		dataType: string
		lineageTag: 45f2658d-ae07-53bd-880d-8d6a558919f7
		summarizeBy: none
