/// SKUs (5.000) com fornecedor único (ponte 1:1 validada no GATE A) e Classe ABC estática do período completo.
table dProduto
	lineageTag: cfa86c35-478c-53f0-8269-5dda7861c092

	column id_produto
		dataType: string
		isHidden
		lineageTag: 60208f27-8817-5b8c-a634-27e3c9a89342
		summarizeBy: none
		sourceColumn: id_produto

		annotation SummarizationSetBy = Automatic

	column Produto
		dataType: string
		lineageTag: 9aaca5bf-90dd-5c05-9d2f-cdfc20038c42
		summarizeBy: none
		sourceColumn: nome_produto

		annotation SummarizationSetBy = Automatic

	column Categoria
		dataType: string
		lineageTag: 84aae102-3175-5e29-b8d2-d3658cea3dbc
		summarizeBy: none
		sourceColumn: categoria

