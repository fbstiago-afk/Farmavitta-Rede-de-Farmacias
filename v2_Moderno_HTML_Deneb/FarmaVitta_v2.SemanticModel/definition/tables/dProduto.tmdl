	column 'Custo Ref'
		dataType: double
		formatString: \R\$ #,0.00
		lineageTag: 4c966fd1-acd4-5839-9ebd-397ef4ccb6cf
		summarizeBy: none
		sourceColumn: custo_unitario_referencia

