	measure 'Check Lotes vs Saldo Final' = CALCULATE ( SUM ( fLotes[quantidade_lote] ), REMOVEFILTERS () ) - CALCULATE ( SUM ( fEstoque[saldo_final] ), REMOVEFILTERS (), fEstoque[data_mes] = DATE ( 2026, 9, 1 ) )
		formatString: #,0
		displayFolder: 99 Auditoria
		lineageTag: 9bb856b1-2a94-59ef-9a25-54f4c92e22a7

	measure 'Cor Atingimento' = VAR _a = [Atingimento Meta %] RETURN IF ( ISBLANK ( _a ), "#9FC9C1", IF ( _a >= 1, "#18B89F", IF ( _a >= 0.95, "#F2C46D", "#EF9277" ) ) )
