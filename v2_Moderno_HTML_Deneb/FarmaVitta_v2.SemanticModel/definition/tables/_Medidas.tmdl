	measure 'Cor Cobertura' = VAR _c = [Cobertura (dias)] RETURN IF ( ISBLANK ( _c ), "#9FC9C1", IF ( _c <= 60, "#18B89F", IF ( _c <= 120, "#F2C46D", "#EF9277" ) ) )
