			VAR _mx = CALCULATE ( MAXX ( ALLSELECTED ( dProduto[Produto] ), [Receita Líquida Itens] ), ALLSELECTED ( dProduto[Produto] ) )
			VAR _w = IF ( _mx > 0, MAX ( 2, DIVIDE ( _v, _mx ) * 116 ), 0 )
