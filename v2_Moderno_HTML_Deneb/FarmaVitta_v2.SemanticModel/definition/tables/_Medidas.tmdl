			VAR _x2 = IF ( ISBLANK ( _d2 ), "sem base comparável no ano anterior", IF ( _d2 >= 0, "▲ +", "▼ −" ) & FORMAT ( ABS ( _d2 ), "0.0", "pt-BR" ) & " p.p. vs ano anterior" )
