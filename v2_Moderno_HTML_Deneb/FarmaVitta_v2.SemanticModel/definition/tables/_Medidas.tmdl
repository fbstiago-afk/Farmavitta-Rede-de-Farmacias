	measure 'Cor Margem Op' = VAR _p = [Margem Operacional Simplificada %] RETURN IF ( ISBLANK ( _p ), "#9FC9C1", IF ( _p >= 0.2, "#18B89F", IF ( _p >= 0.1, "#F2C46D", "#EF9277" ) ) )
