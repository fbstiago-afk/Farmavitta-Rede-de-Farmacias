	measure 'Cor Pontualidade' = VAR _p = [Pontualidade %] RETURN IF ( ISBLANK ( _p ), "#9FC9C1", IF ( _p >= 0.9, "#18B89F", IF ( _p >= 0.7, "#F2C46D", "#EF9277" ) ) )
