/// Tabela de medidas.
table _Medidas
	lineageTag: 6f308843-fba4-5e00-a7b2-ef424c857270

	/// Soma do valor bruto dos cupons (f_vendas).
	measure 'Receita Bruta' = SUM ( fVendas[valor_bruto] )
		formatString: \R\$ #,0.00;-\R\$ #,0.00;\R\$ #,0.00
		displayFolder: 00 Base
		lineageTag: ab85e346-84f8-5128-bec8-82bcfaacebfa

	measure Descontos = SUM ( fVendas[valor_desconto] )
		formatString: \R\$ #,0.00;-\R\$ #,0.00;\R\$ #,0.00
		displayFolder: 00 Base
		lineageTag: 4ad242fe-f311-51e9-9f6f-5c0b046e2737

	/// Receita líquida oficial da rede (f_vendas). Não somar com itens.
	measure 'Receita Líquida' = SUM ( fVendas[valor_liquido] )
		formatString: \R\$ #,0.00;-\R\$ #,0.00;\R\$ #,0.00
		displayFolder: 00 Base
		lineageTag: 4a6bed16-3142-54a4-8036-74f6d92a9097

	/// Custo da mercadoria vendida (f_vendas).
	measure CMV = SUM ( fVendas[custo_mercadoria] )
		formatString: \R\$ #,0.00;-\R\$ #,0.00;\R\$ #,0.00
		displayFolder: 00 Base
		lineageTag: 24ebfd99-3874-539d-aae8-263c03d6c539

	/// Número de cupons (vendas). id_venda é único (GATE A).
	measure Cupons = COUNTROWS ( fVendas )
		formatString: #,0
		displayFolder: 00 Base
		lineageTag: 23c4a9f5-4e35-5f7e-9832-37d797fd0497

	measure 'Unidades Vendidas' = SUM ( fItensVenda[quantidade] )
		formatString: #,0
		displayFolder: 00 Base
		lineageTag: 82fa3219-5589-5acf-8913-67c384ce34b5

	measure 'Qtd Lojas' = COUNTROWS ( dLoja )
		formatString: #,0
		displayFolder: 00 Base
		lineageTag: c74b5404-604b-5017-845f-c7c7d3cfa100

	measure 'Clientes Cadastrados' = CALCULATE ( COUNTROWS ( dCliente ), dCliente[id_cliente] <> "NI" )
		formatString: #,0
		displayFolder: 00 Base
		lineageTag: 9f9fb5bf-2be8-5184-bb69-2d8ef2933ac0

	/// Despesas modeladas (loja/mês). Em branco quando filtrado por produto, canal, cliente ou fornecedor.
	measure Despesas = IF ( NOT [_Filtro Sem Despesa], SUM ( fDespesas[despesa_total] ) )
		formatString: \R\$ #,0.00;-\R\$ #,0.00;\R\$ #,0.00
		displayFolder: 00 Base
		lineageTag: 7f7d04d9-0283-5a31-8788-c04fe09c64f2

	measure 'Meta Receita' = IF ( NOT [_Filtro Sem Despesa], SUM ( fMetas[meta_receita] ) )
		formatString: \R\$ #,0.00;-\R\$ #,0.00;\R\$ #,0.00
		displayFolder: 00 Base
		lineageTag: e9972b2f-ab40-5f7d-a850-916a84772356

	measure 'Meta Lucro Bruto' = IF ( NOT [_Filtro Sem Despesa], SUM ( fMetas[meta_lucro_bruto] ) )
		formatString: \R\$ #,0.00;-\R\$ #,0.00;\R\$ #,0.00
		displayFolder: 00 Base
		lineageTag: 22363418-815c-5dbb-a89f-07ccb3d5f0fa

	/// Verdadeiro quando há filtro em dimensão que não existe nas fatos de meta/despesa (evita números enganosos).
	measure '_Filtro Sem Despesa' = ISFILTERED ( dProduto ) || ISFILTERED ( dCanal ) || ISFILTERED ( dCliente ) || ISFILTERED ( dFornecedor )
		displayFolder: 99 Auditoria
		isHidden
		lineageTag: 5eb81bcf-19c4-5ea2-9d2f-cf668c9f5659

	/// Último dia com venda na base (limita comparações com o ano anterior).
	measure '_Data Base' = CALCULATE ( MAX ( fVendas[data_venda] ), REMOVEFILTERS () )
		formatString: dd/MM/yyyy
		displayFolder: 01 Tempo
		isHidden
		lineageTag: ffcc58ce-5001-533b-a529-1c25191a6dc9

	/// Verdadeiro quando o mesmo período do ano anterior está inteiramente coberto pela base (≥ 01/10/2024).
	measure '_Periodo Comparavel LY' =
			VAR _ini = CALCULATE ( MIN ( fVendas[data_venda] ) )
			RETURN NOT ISBLANK ( _ini ) && EDATE ( _ini, -12 ) >= DATE ( 2024, 10, 1 )
		displayFolder: 01 Tempo
		isHidden
		lineageTag: e1bdd7e6-e543-5bac-adfe-245a7995e811

	measure 'Receita Líquida LY' = IF ( [_Periodo Comparavel LY], CALCULATE ( [Receita Líquida], SAMEPERIODLASTYEAR ( VAR _db = [_Data Base] RETURN CALCULATETABLE ( VALUES ( dCalendario[Data] ), KEEPFILTERS ( dCalendario[Data] <= _db ) ) ) ) )
		formatString: \R\$ #,0.00;-\R\$ #,0.00;\R\$ #,0.00
		displayFolder: 01 Tempo
		lineageTag: beca504c-3cb9-5b0e-a45a-488349736d17

	measure 'Receita YoY %' = DIVIDE ( [Receita Líquida] - [Receita Líquida LY], [Receita Líquida LY] )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 01 Tempo
		lineageTag: eb01a9a7-5934-5b08-bf5b-140f1f52ee07

	measure 'Lucro Bruto LY' = IF ( [_Periodo Comparavel LY], CALCULATE ( [Lucro Bruto], SAMEPERIODLASTYEAR ( VAR _db = [_Data Base] RETURN CALCULATETABLE ( VALUES ( dCalendario[Data] ), KEEPFILTERS ( dCalendario[Data] <= _db ) ) ) ) )
		formatString: \R\$ #,0.00;-\R\$ #,0.00;\R\$ #,0.00
		displayFolder: 01 Tempo
		lineageTag: 681c9fb4-c36c-5221-918f-58894e8d2ea4

	measure 'Lucro Bruto YoY %' = DIVIDE ( [Lucro Bruto] - [Lucro Bruto LY], [Lucro Bruto LY] )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 01 Tempo
		lineageTag: 4c88c12c-884a-58ae-a43d-d3dfbb99231e

	measure 'Margem Bruta LY' = DIVIDE ( [Lucro Bruto LY], [Receita Líquida LY] )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 01 Tempo
		lineageTag: aa060292-de8b-50c4-a2d9-d7add73e0ed7

	measure 'Margem Bruta Var pp' = IF ( NOT ISBLANK ( [Margem Bruta LY] ), ( [Margem Bruta %] - [Margem Bruta LY] ) * 100 )
		formatString: +0.0 "p.p.";-0.0 "p.p.";0.0 "p.p."
		displayFolder: 01 Tempo
		lineageTag: aef76124-a42f-5b89-b737-b1c7acdc365b

	measure 'Cupons LY' = IF ( [_Periodo Comparavel LY], CALCULATE ( [Cupons], SAMEPERIODLASTYEAR ( VAR _db = [_Data Base] RETURN CALCULATETABLE ( VALUES ( dCalendario[Data] ), KEEPFILTERS ( dCalendario[Data] <= _db ) ) ) ) )
		formatString: #,0
		displayFolder: 01 Tempo
		lineageTag: 51d1b6b4-a5f2-5c50-b835-d80a815cafe4

	measure 'Cupons YoY %' = DIVIDE ( [Cupons] - [Cupons LY], [Cupons LY] )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 01 Tempo
		lineageTag: 44918306-118c-566e-9631-f4726c1c08b7

	measure 'Ticket Médio LY' = DIVIDE ( [Receita Líquida LY], [Cupons LY] )
		formatString: \R\$ #,0.00;-\R\$ #,0.00;\R\$ #,0.00
		displayFolder: 01 Tempo
		lineageTag: 7e0f1319-6526-5756-8c4b-03f3808cfd1c

	measure 'Ticket Médio YoY %' = DIVIDE ( [Ticket Médio] - [Ticket Médio LY], [Ticket Médio LY] )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 01 Tempo
		lineageTag: dd0e3810-df23-5b60-8e15-e664b162e349

	measure 'Resultado Op Simplificado LY' = IF ( [_Periodo Comparavel LY], CALCULATE ( [Resultado Operacional Simplificado], SAMEPERIODLASTYEAR ( VAR _db = [_Data Base] RETURN CALCULATETABLE ( VALUES ( dCalendario[Data] ), KEEPFILTERS ( dCalendario[Data] <= _db ) ) ) ) )
		formatString: \R\$ #,0.00;-\R\$ #,0.00;\R\$ #,0.00
		displayFolder: 01 Tempo
		lineageTag: 97436462-807c-5132-8338-6acafea34bcc

	measure 'Resultado Op Simplificado YoY %' = DIVIDE ( [Resultado Operacional Simplificado] - [Resultado Op Simplificado LY], ABS ( [Resultado Op Simplificado LY] ) )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 01 Tempo
		lineageTag: 334abffc-0b44-5a72-bdf7-46840f416a79

	measure 'Receita Mês Anterior' = CALCULATE ( [Receita Líquida], DATEADD ( dCalendario[Data], -1, MONTH ) )
		formatString: \R\$ #,0.00;-\R\$ #,0.00;\R\$ #,0.00
		displayFolder: 01 Tempo
		lineageTag: 42f8d4e5-bc77-586a-a6b5-5cf4f725956b

	measure 'Receita MoM %' = DIVIDE ( [Receita Líquida] - [Receita Mês Anterior], [Receita Mês Anterior] )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 01 Tempo
		lineageTag: 547b5620-69b8-5b03-af81-b128b3061e2b

	measure 'Receita Acumulada Ano' = TOTALYTD ( [Receita Líquida], dCalendario[Data] )
		formatString: \R\$ #,0.00;-\R\$ #,0.00;\R\$ #,0.00
		displayFolder: 01 Tempo
		lineageTag: 8b8a4158-b862-5dc9-8c68-c2e50bc8aaac

	measure 'Meses com Venda' = COUNTROWS ( FILTER ( VALUES ( dCalendario[AnoMes Num] ), CALCULATE ( NOT ISEMPTY ( fVendas ) ) ) )
		formatString: #,0
		displayFolder: 01 Tempo
		lineageTag: 0ab2bd0a-7e39-5540-b70e-2791745877d9

	measure 'Período Selecionado' =
			VAR _i = CALCULATE ( MIN ( fVendas[data_venda] ) )
			VAR _f = CALCULATE ( MAX ( fVendas[data_venda] ) )
			RETURN IF ( ISBLANK ( _i ), "Sem vendas no período", FORMAT ( _i, "dd/mm/yyyy" ) & " a " & FORMAT ( _f, "dd/mm/yyyy" ) )
		displayFolder: 01 Tempo
		lineageTag: 706c9230-174e-52a2-8848-78e7d04fcdd5

	/// Receita líquida − CMV (f_vendas).
	measure 'Lucro Bruto' = [Receita Líquida] - [CMV]
		formatString: \R\$ #,0.00;-\R\$ #,0.00;\R\$ #,0.00
		displayFolder: 02 Comercial
		lineageTag: 6abd3226-da9b-5e04-8d33-291b2666b936

	measure 'Margem Bruta %' = DIVIDE ( [Lucro Bruto], [Receita Líquida] )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 02 Comercial
		lineageTag: 69507fd6-4f51-5287-a1b5-a6c436cadf2c

	measure 'Ticket Médio' = DIVIDE ( [Receita Líquida], [Cupons] )
		formatString: \R\$ #,0.00;-\R\$ #,0.00;\R\$ #,0.00
		displayFolder: 02 Comercial
		lineageTag: 7ea4d07d-3b87-5790-9c4c-665c7eb96780

	/// Unidades por cupom (não confundir com SKUs distintos).
	measure 'Itens por Cupom' = DIVIDE ( [Unidades Vendidas], [Cupons] )
		formatString: #,0.00
		displayFolder: 02 Comercial
		lineageTag: 5e803496-f4a1-5da3-be41-6033399e951a

	measure 'SKUs por Cupom' = DIVIDE ( SUM ( fVendas[qtd_itens_distintos] ), [Cupons] )
		formatString: #,0.00
		displayFolder: 02 Comercial
		lineageTag: 83692f91-6475-5f7d-a6e7-fd6399911b2b

	measure 'Desconto %' = DIVIDE ( [Descontos], [Receita Bruta] )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 02 Comercial
		lineageTag: 59d90431-c51f-5990-aed3-f03e9988120e

	/// Receita líquida / meta. Em branco com filtro de produto/canal/cliente.
	measure 'Atingimento Meta %' = DIVIDE ( [Receita Líquida], [Meta Receita] )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 02 Comercial
		lineageTag: 8004b3ce-6465-5f58-aa1d-cefd1f4f7040

	measure 'Gap Meta' = IF ( NOT ISBLANK ( [Meta Receita] ), [Receita Líquida] - [Meta Receita] )
		formatString: \R\$ #,0.00;-\R\$ #,0.00;\R\$ #,0.00
		displayFolder: 02 Comercial
		lineageTag: 1175f9c2-2f1b-51e9-9a4e-03f030b7290d

	measure 'Share Receita %' = DIVIDE ( [Receita Líquida], CALCULATE ( [Receita Líquida], ALLSELECTED () ) )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 02 Comercial
		lineageTag: 8e8e8b83-9411-581d-a89e-e8760efbe1b7

	measure 'Lojas na Meta' = COUNTROWS ( FILTER ( VALUES ( dLoja[id_loja] ), [Atingimento Meta %] >= 1 ) )
		formatString: #,0
		displayFolder: 02 Comercial
		lineageTag: 465e6d40-062e-55ee-ac7b-835b6d40492b

	measure 'Cupons Identificados' = CALCULATE ( [Cupons], fVendas[cliente_identificado] = TRUE () )
		formatString: #,0
		displayFolder: 03 Clientes
		lineageTag: cfb550a2-58ec-59b4-bbca-228c8eec56a9

	measure '% Cupons Identificados' = DIVIDE ( [Cupons Identificados], [Cupons] )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 03 Clientes
		lineageTag: a6a2959b-f8de-56e4-a4de-ecb1f60b96ca

	/// Clientes identificados com ao menos 1 cupom no período. Cupom anônimo não é cliente.
	measure 'Clientes Ativos' = CALCULATE ( DISTINCTCOUNT ( fVendas[id_cliente] ), fVendas[cliente_identificado] = TRUE () )
		formatString: #,0
		displayFolder: 03 Clientes
		lineageTag: 712aca7d-ef5b-5fdf-a618-910599d4e230

	measure 'Clientes Ativos LY' = IF ( [_Periodo Comparavel LY], CALCULATE ( [Clientes Ativos], SAMEPERIODLASTYEAR ( VAR _db = [_Data Base] RETURN CALCULATETABLE ( VALUES ( dCalendario[Data] ), KEEPFILTERS ( dCalendario[Data] <= _db ) ) ) ) )
		formatString: #,0
		displayFolder: 03 Clientes
		lineageTag: 865bfd54-e774-542c-826d-3a5c42aa1484

	measure 'Clientes Ativos YoY %' = DIVIDE ( [Clientes Ativos] - [Clientes Ativos LY], [Clientes Ativos LY] )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 03 Clientes
		lineageTag: 58287f75-f87e-5ed3-8a18-3df273408ade

	/// Primeira compra observada na base (desde 01/10/2024): nos primeiros meses quase todos aparecem como novos.
	measure 'Clientes Novos' = CALCULATE ( DISTINCTCOUNT ( fVendas[id_cliente] ), fVendas[primeira_compra] = TRUE () )
		formatString: #,0
		displayFolder: 03 Clientes
		lineageTag: 6e0fe3dd-bea6-5726-a3f0-cf235e291c3c

	measure 'Clientes Recorrentes' = [Clientes Ativos] - [Clientes Novos]
		formatString: #,0
		displayFolder: 03 Clientes
		lineageTag: 55082281-d199-592d-b5c6-665408e1d601

	measure '% Clientes Novos' = DIVIDE ( [Clientes Novos], [Clientes Ativos] )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 03 Clientes
		lineageTag: ab49a6ea-89ca-50a1-8dae-4054305fe8e8

	/// Cupons por cliente identificado no período.
	measure 'Frequência Média' = DIVIDE ( [Cupons Identificados], [Clientes Ativos] )
		formatString: #,0.00
		displayFolder: 03 Clientes
		lineageTag: fc90363b-f94c-57fc-9ea2-4b116f5990a9

	/// % de clientes ativos com 2+ cupons no período.
	measure 'Taxa de Recompra %' =
			VAR _rec = COUNTROWS ( FILTER ( CALCULATETABLE ( VALUES ( fVendas[id_cliente] ), fVendas[cliente_identificado] = TRUE () ), CALCULATE ( COUNTROWS ( fVendas ) ) >= 2 ) )
			RETURN DIVIDE ( _rec, [Clientes Ativos] )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 03 Clientes
		lineageTag: dcb1915d-774d-5c71-8fd7-b9297cd9de7c

	measure 'Ticket Médio Identificado' = CALCULATE ( [Ticket Médio], fVendas[cliente_identificado] = TRUE () )
		formatString: \R\$ #,0.00;-\R\$ #,0.00;\R\$ #,0.00
		displayFolder: 03 Clientes
		lineageTag: fbbc7043-b917-5bd5-afaa-fb85362873a2

	measure 'Ticket Médio Anônimo' = CALCULATE ( [Ticket Médio], fVendas[cliente_identificado] = FALSE () )
		formatString: \R\$ #,0.00;-\R\$ #,0.00;\R\$ #,0.00
		displayFolder: 03 Clientes
		lineageTag: 32988428-9372-5196-8afa-8f6868737655

	measure 'Receita por Cliente' = DIVIDE ( CALCULATE ( [Receita Líquida], fVendas[cliente_identificado] = TRUE () ), [Clientes Ativos] )
		formatString: \R\$ #,0.00;-\R\$ #,0.00;\R\$ #,0.00
		displayFolder: 03 Clientes
		lineageTag: e7983aa0-2b14-5cc4-98ab-a1e6e7b97ee2

	/// Receita líquida na granularidade de item (para produto/categoria).
	measure 'Receita Líquida Itens' = SUM ( fItensVenda[valor_liquido] )
		formatString: \R\$ #,0.00;-\R\$ #,0.00;\R\$ #,0.00
		displayFolder: 04 Produtos
		lineageTag: d69701cc-1771-5884-ae05-178be1e4ac09

	measure 'CMV Itens' = SUM ( fItensVenda[custo_total] )
		formatString: \R\$ #,0.00;-\R\$ #,0.00;\R\$ #,0.00
		displayFolder: 04 Produtos
		lineageTag: 2de7884a-2d99-52ef-b6c8-f95aac436eb3

	measure 'Descontos Itens' = SUM ( fItensVenda[valor_desconto] )
		formatString: \R\$ #,0.00;-\R\$ #,0.00;\R\$ #,0.00
		displayFolder: 04 Produtos
		lineageTag: aee3124b-d924-56ff-9a2c-f71a25d05f0d

	measure 'Lucro Bruto Itens' = [Receita Líquida Itens] - [CMV Itens]
		formatString: \R\$ #,0.00;-\R\$ #,0.00;\R\$ #,0.00
		displayFolder: 04 Produtos
		lineageTag: 9b402a06-b7d7-5049-9379-cf32a234b3da

	measure 'Margem Bruta Itens %' = DIVIDE ( [Lucro Bruto Itens], [Receita Líquida Itens] )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 04 Produtos
		lineageTag: 8dca682f-0fc3-5bae-ac9f-f54e928a58da

	measure 'Desconto Itens %' = DIVIDE ( [Descontos Itens], [Receita Líquida Itens] + [Descontos Itens] )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 04 Produtos
		lineageTag: 88205316-6ac8-529c-9361-ac10df345a24

	measure 'SKUs Vendidos' = DISTINCTCOUNT ( fItensVenda[id_produto] )
		formatString: #,0
		displayFolder: 04 Produtos
		lineageTag: d7ba663a-0b00-5f37-a69b-c96ef70a8944

	measure 'SKUs no Catálogo' = COUNTROWS ( dProduto )
		formatString: #,0
		displayFolder: 04 Produtos
		lineageTag: f4c0ed8b-46b6-55db-b500-3a3f7d568324

	measure '% SKUs com Venda' = DIVIDE ( [SKUs Vendidos], [SKUs no Catálogo] )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 04 Produtos
		lineageTag: 0f84b627-8f1a-5106-bac1-ff4e5c0636aa

	measure 'Preço Médio Unitário' = DIVIDE ( [Receita Líquida Itens], [Unidades Vendidas] )
		formatString: \R\$ #,0.00;-\R\$ #,0.00;\R\$ #,0.00
		displayFolder: 04 Produtos
		lineageTag: 8ee4f117-703a-5c9b-a1ce-c7549b8b4fe6

	measure 'Share Receita Itens %' = DIVIDE ( [Receita Líquida Itens], CALCULATE ( [Receita Líquida Itens], ALLSELECTED ( dProduto ) ) )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 04 Produtos
		lineageTag: a38b04d3-2d82-5fad-96b9-952fcd6d67d8

	measure '% SKUs Vendidos' = DIVIDE ( [SKUs Vendidos], CALCULATE ( [SKUs Vendidos], ALLSELECTED ( dProduto ) ) )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 04 Produtos
		lineageTag: ee930ff5-ef14-528c-8d09-e368ff3a3a73

	measure 'Contribuição Lucro %' = DIVIDE ( [Lucro Bruto Itens], CALCULATE ( [Lucro Bruto Itens], ALLSELECTED ( dProduto ) ) )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 04 Produtos
		lineageTag: 5fe4f45e-ec7a-57d8-9948-b51954483d25

	measure 'Receita Itens LY' = IF ( [_Periodo Comparavel LY], CALCULATE ( [Receita Líquida Itens], SAMEPERIODLASTYEAR ( VAR _db = [_Data Base] RETURN CALCULATETABLE ( VALUES ( dCalendario[Data] ), KEEPFILTERS ( dCalendario[Data] <= _db ) ) ) ) )
		formatString: \R\$ #,0.00;-\R\$ #,0.00;\R\$ #,0.00
		displayFolder: 04 Produtos
		lineageTag: 88a194d8-4c27-5b09-a9d4-a18266cfafa7

	measure 'Receita Itens YoY %' = DIVIDE ( [Receita Líquida Itens] - [Receita Itens LY], [Receita Itens LY] )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 04 Produtos
		lineageTag: 867d729c-4a7c-5d83-bac9-6eafd9fb3ce2

	measure 'Receita Itens Var LY' = IF ( NOT ISBLANK ( [Receita Itens LY] ), [Receita Líquida Itens] - [Receita Itens LY] )
		formatString: \R\$ #,0.00;-\R\$ #,0.00;\R\$ #,0.00
		displayFolder: 04 Produtos
		lineageTag: 268c4471-1236-5b5a-bab6-77e98d0518e1

	measure 'Margem Itens LY' = IF ( [_Periodo Comparavel LY], CALCULATE ( [Margem Bruta Itens %], SAMEPERIODLASTYEAR ( VAR _db = [_Data Base] RETURN CALCULATETABLE ( VALUES ( dCalendario[Data] ), KEEPFILTERS ( dCalendario[Data] <= _db ) ) ) ) )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 04 Produtos
		lineageTag: 52ae1d02-6df3-5aff-9b70-fb056a8cd5f4

	measure 'Margem Itens Var pp' = IF ( NOT ISBLANK ( [Margem Itens LY] ), ( [Margem Bruta Itens %] - [Margem Itens LY] ) * 100 )
		formatString: +0.0 "p.p.";-0.0 "p.p.";0.0 "p.p."
		displayFolder: 04 Produtos
		lineageTag: 84fce524-b4a7-5a0f-91f9-e5ce55948fec

	measure 'Ranking SKU' = IF ( NOT ISBLANK ( [Receita Líquida Itens] ), RANKX ( ALLSELECTED ( dProduto ), [Receita Líquida Itens],, DESC, DENSE ) )
		formatString: #,0
		displayFolder: 04 Produtos
		lineageTag: cddba88b-bc68-5f67-9be0-6b8934b33957

	/// Pareto dinâmico por SKU dentro da seleção. Custoso: usar em tabelas, não em gráficos com 5.000 pontos.
	measure 'Receita Acumulada % (Pareto)' =
			VAR _r = [Receita Líquida Itens]
			VAR _t = ADDCOLUMNS ( ALLSELECTED ( dProduto[id_produto] ), "@r", [Receita Líquida Itens] )
			VAR _acc = SUMX ( FILTER ( _t, [@r] >= _r ), [@r] )
			RETURN IF ( NOT ISBLANK ( _r ), DIVIDE ( _acc, SUMX ( _t, [@r] ) ) )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 04 Produtos
		lineageTag: 65eecabe-0a56-5cfc-8dde-741258cba14a

	/// Compras recebidas valorizadas (base complementar). Não somar ao CMV.
	measure 'Valor Recebido' = SUM ( fRecebimentos[valor_recebido] )
		formatString: \R\$ #,0.00;-\R\$ #,0.00;\R\$ #,0.00
		displayFolder: 05 Compras
		lineageTag: 7092fbf1-4848-57bb-bab1-44865464574a

	measure 'Qtd Recebida' = SUM ( fRecebimentos[quantidade_recebida] )
		formatString: #,0
		displayFolder: 05 Compras
		lineageTag: be5f6602-7043-5a42-8b9e-e720454b3f14

	measure Recebimentos = COUNTROWS ( fRecebimentos )
		formatString: #,0
		displayFolder: 05 Compras
		lineageTag: b64c97b2-ff00-5597-875b-f4e9e6f80f57

	/// Prazo real médio (dias) informado no recebimento.
	measure 'Lead Time Médio' = AVERAGE ( fRecebimentos[prazo_real_dias] )
		formatString: #,0.0 "dias"
		displayFolder: 05 Compras
		lineageTag: 2e7f31a9-cfc2-5ce8-bd01-d294d51d485c

	measure 'Prazo Previsto Médio' = AVERAGE ( fRecebimentos[prazo_previsto_dias] )
		formatString: #,0.0 "dias"
		displayFolder: 05 Compras
		lineageTag: ae7e8dcc-8d5b-5ac0-8626-1e434566f6d2

	/// Média de dias de atraso apenas entre entregas atrasadas.
	measure 'Atraso Médio' = AVERAGEX ( FILTER ( fRecebimentos, fRecebimentos[atraso_dias] > 0 ), fRecebimentos[atraso_dias] )
		formatString: #,0.0 "dias"
		displayFolder: 05 Compras
		lineageTag: 30a42efc-e1ba-5f4c-bf8a-567b2489500e

	/// Entregas no prazo / recebimentos (OTD). Não é OTIF: não há pedido/quantidade prometida.
	measure 'Pontualidade %' = DIVIDE ( SUM ( fRecebimentos[entrega_no_prazo] ), [Recebimentos] )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 05 Compras
		lineageTag: ef8b6610-3154-536a-bc15-3d2b36950717

	measure 'Custo Médio Recebido' = DIVIDE ( [Valor Recebido], [Qtd Recebida] )
		formatString: \R\$ #,0.00;-\R\$ #,0.00;\R\$ #,0.00
		displayFolder: 05 Compras
		lineageTag: b154199f-2a95-5a5f-ae53-4be8c9455243

	/// Custo pago vs custo de referência do cadastro. Não é saving (não há baseline negociado).
	measure 'Variação Custo vs Referência %' = DIVIDE ( [Valor Recebido], SUMX ( fRecebimentos, fRecebimentos[quantidade_recebida] * RELATED ( dProduto[Custo Ref] ) ) ) - 1
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 05 Compras
		lineageTag: 760debae-3e85-5a08-aa5a-a19b47a914a2

	measure 'Fornecedores Ativos' = DISTINCTCOUNT ( fRecebimentos[id_fornecedor] )
		formatString: #,0
		displayFolder: 05 Compras
		lineageTag: 06964d87-6ee1-57eb-8586-1bd7d425de43

	measure 'Concentração Top 5 %' =
			VAR _top = TOPN ( 5, VALUES ( dFornecedor[id_fornecedor] ), [Valor Recebido], DESC )
			RETURN DIVIDE ( CALCULATE ( [Valor Recebido], KEEPFILTERS ( _top ) ), [Valor Recebido] )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 05 Compras
		lineageTag: 68ec5c5c-5bc0-5559-9492-ff693a7eb6f8

	measure 'Share Compras %' = DIVIDE ( [Valor Recebido], CALCULATE ( [Valor Recebido], ALLSELECTED () ) )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 05 Compras
		lineageTag: 213bd713-5455-5e66-aeb3-9fae597104b6

	measure 'Orçamento Compras' = IF ( NOT [_Filtro Sem Despesa], SUM ( fOrcamentoCompras[orcamento_compras] ) )
		formatString: \R\$ #,0.00;-\R\$ #,0.00;\R\$ #,0.00
		displayFolder: 05 Compras
		lineageTag: 8edcefd2-6093-5d1e-8a4a-fcc90da41862

	measure 'Desvio vs Orçamento' = IF ( NOT ISBLANK ( [Orçamento Compras] ), [Valor Recebido] - [Orçamento Compras] )
		formatString: \R\$ #,0.00;-\R\$ #,0.00;\R\$ #,0.00
		displayFolder: 05 Compras
		lineageTag: 16949e0b-f15f-5473-99aa-4017d6e8ceb0

	measure 'Desvio vs Orçamento %' = DIVIDE ( [Desvio vs Orçamento], [Orçamento Compras] )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 05 Compras
		lineageTag: c44aa867-b655-54ad-8acd-d72c6de20abe

	/// Compras recebidas / CMV de itens. < 100% indica consumo de estoque inicial.
	measure 'Compras / CMV %' = DIVIDE ( [Valor Recebido], [CMV Itens] )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 05 Compras
		lineageTag: 25a63ccc-2a36-59ec-9491-30fe87a4f56b

	/// Último mês com saldo dentro do filtro de datas.
	measure '_Mes Snapshot' = CALCULATE ( MAX ( fEstoque[data_mes] ) )
		formatString: dd/MM/yyyy
		displayFolder: 06 Estoque
		isHidden
		lineageTag: 4e29496a-84a2-5567-be0f-20d519a97ad0

	/// Saldo valorizado no último mês do período (semiaditivo; nunca soma meses).
	measure 'Estoque Final (R$)' =
			VAR _m = [_Mes Snapshot]
			RETURN CALCULATE ( SUM ( fEstoque[valor_saldo_final] ), REMOVEFILTERS ( dCalendario ), fEstoque[data_mes] = _m )
		formatString: \R\$ #,0.00;-\R\$ #,0.00;\R\$ #,0.00
		displayFolder: 06 Estoque
		lineageTag: a2822616-d20a-5f56-b79e-afa9d8e85643

	measure 'Estoque Final (un)' =
			VAR _m = [_Mes Snapshot]
			RETURN CALCULATE ( SUM ( fEstoque[saldo_final] ), REMOVEFILTERS ( dCalendario ), fEstoque[data_mes] = _m )
		formatString: #,0
		displayFolder: 06 Estoque
		lineageTag: 4e7d09d0-54bb-5844-8fa8-946c1b55243c

	measure 'Estoque Médio (R$)' = AVERAGEX ( FILTER ( VALUES ( dCalendario[AnoMes Num] ), CALCULATE ( NOT ISEMPTY ( fEstoque ) ) ), CALCULATE ( SUM ( fEstoque[valor_saldo_final] ) ) )
		formatString: \R\$ #,0.00;-\R\$ #,0.00;\R\$ #,0.00
		displayFolder: 06 Estoque
		lineageTag: 584957a8-8a5d-5c73-b3f7-31a3c053559d

	measure 'Meses Estoque' = COUNTROWS ( FILTER ( VALUES ( dCalendario[AnoMes Num] ), CALCULATE ( NOT ISEMPTY ( fEstoque ) ) ) )
		formatString: #,0
		displayFolder: 06 Estoque
		lineageTag: b5e6dfc1-21f2-5a9c-ba79-7779ff7f30e4

	measure 'Entradas (un)' = SUM ( fEstoque[qtd_entradas] )
		formatString: #,0
		displayFolder: 06 Estoque
		lineageTag: 98f9582d-1f0a-5ad1-a168-c6293ed7c47f

	measure 'Perdas (un)' = SUM ( fEstoque[qtd_perdas] )
		formatString: #,0
		displayFolder: 06 Estoque
		lineageTag: 31355b48-4ce4-59c9-b571-707d11d5e46b

	/// Perdas valorizadas ao custo de referência do mês.
	measure 'Perdas (R$)' = SUM ( fEstoque[valor_perdas] )
		formatString: \R\$ #,0.00;-\R\$ #,0.00;\R\$ #,0.00
		displayFolder: 06 Estoque
		lineageTag: 0b39dbf8-81da-5f36-a42a-794fea0d2082

	measure 'Perdas % CMV' = DIVIDE ( [Perdas (R$)], [CMV Itens] )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 06 Estoque
		lineageTag: fdad4d6e-d756-545a-acbe-fb195a0ef326

	/// CMV de itens / estoque médio, anualizado.
	measure 'Giro Anualizado' = DIVIDE ( [CMV Itens], [Estoque Médio (R$)] ) * DIVIDE ( 12, [Meses Estoque] )
		formatString: 0.0"x"
		displayFolder: 06 Estoque
		lineageTag: aac77c15-e7fe-53b3-9096-d75050357521

	/// Saldo final / venda média diária dos últimos 3 meses. Estimativa, não previsão de ruptura.
	measure 'Cobertura (dias)' =
			VAR _m = [_Mes Snapshot]
			VAR _v3 = CALCULATE ( SUM ( fEstoque[qtd_vendida] ), REMOVEFILTERS ( dCalendario ), fEstoque[data_mes] > EDATE ( _m, -3 ), fEstoque[data_mes] <= _m )
			RETURN DIVIDE ( [Estoque Final (un)], _v3 / 91.25 )
		formatString: #,0 "dias"
		displayFolder: 06 Estoque
		lineageTag: 2b3505f9-c254-5dd1-b8c1-ed4f2440578f

	/// Pares loja×SKU no último mês do período.
	measure 'Posições de Estoque' =
			VAR _m = [_Mes Snapshot]
			RETURN CALCULATE ( COUNTROWS ( fEstoque ), REMOVEFILTERS ( dCalendario ), fEstoque[data_mes] = _m )
		formatString: #,0
		displayFolder: 06 Estoque
		lineageTag: 1aa79a50-e727-59a7-8e25-ef2be5ae4f14

	measure 'Posições Sem Giro' = CALCULATE ( [Posições de Estoque], fEstoque[Status Estoque] = "Sem giro" )
		formatString: #,0
		displayFolder: 06 Estoque
		lineageTag: 26e8bd12-24b9-551b-92ee-b9bbf4da34a6

	measure 'Posições em Excesso' = CALCULATE ( [Posições de Estoque], fEstoque[Status Estoque] = "Excesso" )
		formatString: #,0
		displayFolder: 06 Estoque
		lineageTag: 191fc774-2db5-59eb-92a5-a30cffe4c324

	measure 'Valor em Excesso (R$)' = CALCULATE ( [Estoque Final (R$)], fEstoque[Status Estoque] = "Excesso" )
		formatString: \R\$ #,0.00;-\R\$ #,0.00;\R\$ #,0.00
		displayFolder: 06 Estoque
		lineageTag: f968681a-dd82-5b7a-8768-37b837a9c81b

	measure '% Valor em Excesso' = DIVIDE ( [Valor em Excesso (R$)], [Estoque Final (R$)] )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 06 Estoque
		lineageTag: 8b374a23-51a3-576c-bdc7-01a1c6c08078

	measure 'Valor Sem Giro (R$)' = CALCULATE ( [Estoque Final (R$)], fEstoque[Status Estoque] = "Sem giro" )
		formatString: \R\$ #,0.00;-\R\$ #,0.00;\R\$ #,0.00
		displayFolder: 06 Estoque
		lineageTag: 003478e6-2df8-5716-b68a-b55158183c8d

	/// Foto de 30/09/2026 (não responde a filtros de data).
	measure 'Valor em Lotes (R$)' = SUM ( fLotes[valor_lote] )
		formatString: \R\$ #,0.00;-\R\$ #,0.00;\R\$ #,0.00
		displayFolder: 06 Estoque
		lineageTag: c98a21a2-229e-5e39-9da2-1db8f2ea3277

	measure 'Valor em Risco Validade (R$)' = CALCULATE ( [Valor em Lotes (R$)], fLotes[Faixa Validade] IN { "Vencido", "Até 90 dias" } )
		formatString: \R\$ #,0.00;-\R\$ #,0.00;\R\$ #,0.00
		displayFolder: 06 Estoque
		lineageTag: cabd9c35-eae4-5cbd-904b-11e223a4e2b7

	measure '% Valor em Risco Validade' = DIVIDE ( [Valor em Risco Validade (R$)], [Valor em Lotes (R$)] )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 06 Estoque
		lineageTag: 0b5b799a-b22b-5ac8-9414-9d8108fcac00

	measure 'Valor Vencido (R$)' = CALCULATE ( [Valor em Lotes (R$)], fLotes[Faixa Validade] = "Vencido" )
		formatString: \R\$ #,0.00;-\R\$ #,0.00;\R\$ #,0.00
		displayFolder: 06 Estoque
		lineageTag: 7e8c681d-a969-5af7-98e8-a32660961533

	measure Pessoal = IF ( NOT [_Filtro Sem Despesa], SUM ( fDespesas[pessoal] ) )
		formatString: \R\$ #,0.00;-\R\$ #,0.00;\R\$ #,0.00
		displayFolder: 07 Financeiro
		lineageTag: 0f8e4579-1dbc-57c5-998c-01fa2071bfd4

	measure Aluguel = IF ( NOT [_Filtro Sem Despesa], SUM ( fDespesas[aluguel] ) )
		formatString: \R\$ #,0.00;-\R\$ #,0.00;\R\$ #,0.00
		displayFolder: 07 Financeiro
		lineageTag: 08938c9f-2148-5070-b197-cfd1b6865729

	measure 'Despesas Operacionais' = IF ( NOT [_Filtro Sem Despesa], SUM ( fDespesas[operacionais] ) )
		formatString: \R\$ #,0.00;-\R\$ #,0.00;\R\$ #,0.00
		displayFolder: 07 Financeiro
		lineageTag: cb5c9f04-f026-526f-8384-9dce320ad996

	measure 'Marketing e Canais' = IF ( NOT [_Filtro Sem Despesa], SUM ( fDespesas[marketing_canais] ) )
		formatString: \R\$ #,0.00;-\R\$ #,0.00;\R\$ #,0.00
		displayFolder: 07 Financeiro
		lineageTag: a0be67e7-5c0c-55bd-bc44-85a7bcc51961

	/// Lucro bruto − despesas modeladas. NÃO é EBITDA, lucro líquido nem fluxo de caixa.
	measure 'Resultado Operacional Simplificado' = IF ( NOT [_Filtro Sem Despesa], [Lucro Bruto] - [Despesas] )
		formatString: \R\$ #,0.00;-\R\$ #,0.00;\R\$ #,0.00
		displayFolder: 07 Financeiro
		lineageTag: 32b5cddb-0a51-5df4-8389-fe4ca3045821

	measure 'Margem Operacional Simplificada %' = DIVIDE ( [Resultado Operacional Simplificado], [Receita Líquida] )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 07 Financeiro
		lineageTag: 5911d17a-33b5-52f6-8441-d05e0dff94a6

	measure 'Despesas % Receita' = DIVIDE ( [Despesas], [Receita Líquida] )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 07 Financeiro
		lineageTag: 580ded9e-37b9-56c4-925d-fbff947c38af

	measure 'Atingimento Lucro Bruto %' = DIVIDE ( [Lucro Bruto], [Meta Lucro Bruto] )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 07 Financeiro
		lineageTag: 454354a3-b160-5a6a-bc42-52a825364c6a

	measure 'Valor DRE' =
			SWITCH ( SELECTEDVALUE ( dDRE[Ordem DRE] ),
			    1, [Receita Bruta], 2, - [Descontos], 3, [Receita Líquida], 4, - [CMV], 5, [Lucro Bruto],
			    6, - [Pessoal], 7, - [Aluguel], 8, - [Despesas Operacionais], 9, - [Marketing e Canais],
			    10, [Resultado Operacional Simplificado] )
		formatString: \R\$ #,0.00;-\R\$ #,0.00;\R\$ #,0.00
		displayFolder: 07 Financeiro
		lineageTag: ff9c21b0-b2ed-5f38-9308-16925c51942a

	measure '% Receita Líquida (DRE)' = DIVIDE ( [Valor DRE], [Receita Líquida] )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 07 Financeiro
		lineageTag: d07b9514-fbd4-57fa-9326-31014843d573

	/// Valores para o waterfall: receita líquida até resultado operacional simplificado (total automático).
	measure 'Valor Ponte Resultado' =
			SWITCH ( SELECTEDVALUE ( dDRE[Ordem DRE] ),
			    3, [Receita Líquida], 4, - [CMV], 6, - [Pessoal], 7, - [Aluguel], 8, - [Despesas Operacionais], 9, - [Marketing e Canais] )
		formatString: \R\$ #,0.00;-\R\$ #,0.00;\R\$ #,0.00
		displayFolder: 07 Financeiro
		lineageTag: ef540b9e-c156-5e30-bf6d-e7bd0ed82b69

	/// Previsão do método com menor WAPE no backtest de cada loja.
	measure 'Receita Prevista' = SUM ( fForecast[previsao] )
		formatString: \R\$ #,0.00;-\R\$ #,0.00;\R\$ #,0.00
		displayFolder: 08 Forecast
		lineageTag: 38aa4499-89b8-5a9d-8c99-bd0d2fa4dabe

	/// Intervalo empírico ~80% a partir dos erros do backtest. Soma de lojas é conservadora.
	measure 'Limite Inferior' = SUM ( fForecast[limite_inferior] )
		formatString: \R\$ #,0.00;-\R\$ #,0.00;\R\$ #,0.00
		displayFolder: 08 Forecast
		lineageTag: b1c00e5c-3f68-5125-a6d0-88cde6deb4a8

	measure 'Limite Superior' = SUM ( fForecast[limite_superior] )
		formatString: \R\$ #,0.00;-\R\$ #,0.00;\R\$ #,0.00
		displayFolder: 08 Forecast
		lineageTag: fd7948a3-75fb-50f9-8e34-ec9928339a16

	measure 'Receita Real (Série)' = IF ( MIN ( dCalendario[Data] ) <= DATE(2026, 9, 30), [Receita Líquida] )
		formatString: \R\$ #,0.00;-\R\$ #,0.00;\R\$ #,0.00
		displayFolder: 08 Forecast
		lineageTag: b79de42b-30f1-519e-a85d-bf6f703b6ddc

	measure 'Fator Receita Cenário' = SELECTEDVALUE ( dCenario[Fator Receita], 1 )
		formatString: 0.00
		displayFolder: 08 Forecast
		lineageTag: e08fa000-8dc2-59fd-8917-8f91386a8f89

	measure 'Fator Custo Cenário' = SELECTEDVALUE ( dCenario[Fator Custo], 1 )
		formatString: 0.00
		displayFolder: 08 Forecast
		lineageTag: 57fdc1a2-d4f1-50f8-9bc1-66b8b174959b

	measure 'Cenário Ativo' = SELECTEDVALUE ( dCenario[Cenario], "Base" )
		displayFolder: 08 Forecast
		lineageTag: 456faa0e-b4fc-50a3-8fe2-d37fa7fc0cc9

	measure 'Receita Prevista Cenário' = [Receita Prevista] * [Fator Receita Cenário]
		formatString: \R\$ #,0.00;-\R\$ #,0.00;\R\$ #,0.00
		displayFolder: 08 Forecast
		lineageTag: 6cc1d416-34d4-576f-a6fa-ff5f7891f787

	measure 'Limite Inferior Cenário' = [Limite Inferior] * [Fator Receita Cenário]
		formatString: \R\$ #,0.00;-\R\$ #,0.00;\R\$ #,0.00
		displayFolder: 08 Forecast
		lineageTag: 229088ff-eba1-5601-b53e-841aae6ab76f

	measure 'Limite Superior Cenário' = [Limite Superior] * [Fator Receita Cenário]
		formatString: \R\$ #,0.00;-\R\$ #,0.00;\R\$ #,0.00
		displayFolder: 08 Forecast
		lineageTag: 97efc7b9-97b5-53d9-9b41-d64738d924e0

	measure 'CMV % Últimos 12m' = CALCULATE ( DIVIDE ( [CMV], [Receita Líquida] ), DATESBETWEEN ( dCalendario[Data], DATE ( 2025, 10, 1 ), DATE ( 2026, 9, 30 ) ) )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 08 Forecast
		lineageTag: 7921e7b9-30c1-5ac4-83d9-961e07f2e816

	/// Receita prevista × (1 − CMV% dos últimos 12 meses × fator de custo). Premissa, não previsão de margem.
	measure 'Lucro Bruto Previsto Cenário' = [Receita Prevista Cenário] * ( 1 - [CMV % Últimos 12m] * [Fator Custo Cenário] )
		formatString: \R\$ #,0.00;-\R\$ #,0.00;\R\$ #,0.00
		displayFolder: 08 Forecast
		lineageTag: b06f46b9-6871-59f6-8895-9651738e30b6

	measure 'Receita LY dos Meses Previstos' =
			SUMX (
			    FILTER ( VALUES ( dCalendario[AnoMes Num] ), CALCULATE ( NOT ISEMPTY ( fForecast ) ) && CALCULATE ( SUM ( fForecast[previsao] ) ) > 0 ),
			    CALCULATE ( [Receita Líquida], SAMEPERIODLASTYEAR ( dCalendario[Data] ) )
			)
		formatString: \R\$ #,0.00;-\R\$ #,0.00;\R\$ #,0.00
		displayFolder: 08 Forecast
		lineageTag: dfc8eb8a-32cb-5b08-a752-b180fd97bd56

	measure 'Crescimento Previsto vs LY %' = DIVIDE ( [Receita Prevista Cenário], [Receita LY dos Meses Previstos] ) - 1
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 08 Forecast
		lineageTag: 7ab91962-2742-59b7-ae45-d26e9569d338

	/// Erro absoluto ponderado do método selecionado (rolling-origin, h=1..3).
	measure 'WAPE Backtest %' = DIVIDE ( CALCULATE ( SUM ( fBacktest[erro_abs] ), fBacktest[metodo_selecionado] = 1 ), CALCULATE ( SUM ( fBacktest[real] ), fBacktest[metodo_selecionado] = 1 ) )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 08 Forecast
		lineageTag: e91bc432-262b-52d0-b3c2-c60fb7d73ef2

	measure 'MAPE Backtest %' = CALCULATE ( AVERAGEX ( fBacktest, ABS ( fBacktest[erro_pct] ) ), fBacktest[metodo_selecionado] = 1 )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 08 Forecast
		lineageTag: a4689c85-ae66-5dbf-929b-4418157e58d1

	measure 'WAPE por Método %' = DIVIDE ( SUM ( fBacktest[erro_abs] ), SUM ( fBacktest[real] ) )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 08 Forecast
		lineageTag: a2842427-4b81-5995-a923-607991e37a2f

	measure 'Viés Backtest %' = DIVIDE ( CALCULATE ( SUMX ( fBacktest, fBacktest[previsto] - fBacktest[real] ), fBacktest[metodo_selecionado] = 1 ), CALCULATE ( SUM ( fBacktest[real] ), fBacktest[metodo_selecionado] = 1 ) )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 08 Forecast
		lineageTag: 4efc23ab-ab32-5d1b-8785-252c3a4867ec

	measure 'Métodos Selecionados' = CONCATENATEX ( SUMMARIZE ( FILTER ( fBacktest, fBacktest[metodo_selecionado] = 1 ), dLoja[Loja Curta], fBacktest[Metodo] ), dLoja[Loja Curta] & ": " & fBacktest[Metodo], " · " )
		displayFolder: 08 Forecast
		lineageTag: 8965f63b-3024-52bf-9419-6e98905a9796

