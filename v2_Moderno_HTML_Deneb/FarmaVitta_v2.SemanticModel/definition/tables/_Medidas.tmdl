	/// Deve ser 0 (RESUMO_BASE.json).
	measure 'Check Receita Referência' = CALCULATE ( [Receita Líquida], REMOVEFILTERS () ) - 35060712
		formatString: \R\$ #,0.00;-\R\$ #,0.00;\R\$ #,0.00
