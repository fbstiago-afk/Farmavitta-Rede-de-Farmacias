	partition fRecebimentos = m
		mode: import
		source =
				let
				    Fonte = fnCsv("01_Dados_Originais\base_complementar\f_recebimentos_compras.csv"),
				    Tipado = Table.TransformColumnTypes(Fonte, {{"id_recebimento", type text}, {"data_recebimento", type date}, {"id_loja", type text}, {"id_produto", type text}, {"id_fornecedor", type text}, {"quantidade_recebida", Int64.Type}, {"custo_unitario", type number}, {"valor_recebido", type number}, {"prazo_previsto_dias", Int64.Type}, {"prazo_real_dias", Int64.Type}, {"entrega_no_prazo", Int64.Type}}, "en-US"),
				    Atraso = Table.AddColumn(Tipado, "atraso_dias", each List.Max({0, [prazo_real_dias] - [prazo_previsto_dias]}), Int64.Type),
				    Ultimo = Atraso,
				    Final = Table.SelectColumns(Ultimo, {"id_recebimento", "data_recebimento", "id_loja", "id_produto", "id_fornecedor", "quantidade_recebida", "custo_unitario", "valor_recebido", "prazo_previsto_dias", "prazo_real_dias", "entrega_no_prazo", "atraso_dias"})
				in
				    Final

	annotation PBI_ResultType = Table
