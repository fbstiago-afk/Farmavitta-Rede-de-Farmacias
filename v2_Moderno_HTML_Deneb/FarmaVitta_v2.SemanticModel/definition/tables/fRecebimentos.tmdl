/// Recebimentos de compras (base complementar), conciliados com entradas do estoque. Não representa pedidos emitidos.
table fRecebimentos
	lineageTag: dc031a2f-6caa-55a6-939a-5e765410b349

	column id_recebimento
		dataType: string
		isHidden
		lineageTag: 5d2bc9ad-6c00-559d-ad81-92fae3b7cce2
		summarizeBy: none
		sourceColumn: id_recebimento

		annotation SummarizationSetBy = Automatic

	column data_recebimento
		dataType: dateTime
		formatString: dd/MM/yyyy
		isHidden
		lineageTag: 8fa95d24-6460-5cc2-bbcf-15c35f301ee0
		summarizeBy: none
		sourceColumn: data_recebimento

		annotation SummarizationSetBy = Automatic

