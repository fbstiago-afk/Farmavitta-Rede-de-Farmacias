	partition fEstoque = m
		mode: import
		source =
				let
				    Fonte = fnCsv("02_Dados_Tratados\f_estoque_saldo_mensal.csv"),
				    Tipado = Table.TransformColumnTypes(Fonte, {{"ano_mes", type text}, {"id_loja", type text}, {"id_produto", type text}, {"saldo_inicial", Int64.Type}, {"qtd_entradas", Int64.Type}, {"qtd_vendida", Int64.Type}, {"qtd_perdas", Int64.Type}, {"saldo_final", Int64.Type}, {"custo_unitario", type number}, {"valor_saldo_final", type number}, {"valor_perdas", type number}, {"teve_movimento", Int64.Type}, {"venda_media_3m", type number}, {"meses_sem_venda", Int64.Type}, {"cobertura_dias", type number}, {"status_estoque", type text}}, "en-US"),
				    DataMes = Table.AddColumn(Tipado, "data_mes", each Date.FromText([ano_mes] & "-01"), type date),
				    Ultimo = DataMes,
				    Final = Table.SelectColumns(Ultimo, {"ano_mes", "data_mes", "id_loja", "id_produto", "saldo_inicial", "qtd_entradas", "qtd_vendida", "qtd_perdas", "saldo_final", "custo_unitario", "valor_saldo_final", "valor_perdas", "teve_movimento", "venda_media_3m", "meses_sem_venda", "cobertura_dias", "status_estoque"})
				in
				    Final

	annotation PBI_ResultType = Table
