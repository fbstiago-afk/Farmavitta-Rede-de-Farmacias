model Model
	culture: pt-BR
	defaultPowerBIDataSourceVersion: powerBI_V3
	discourageImplicitMeasures
	sourceQueryCulture: pt-BR
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_QueryOrder = ["PastaProjeto","fnCsv","dCalendario","dLoja","dProduto","dFornecedor","dCliente","dCanal","fVendas","fItensVenda","fEstoque","fMetas","fDespesas","fRecebimentos","fOrcamentoCompras","fLotes","fForecast","fBacktest","dCenario","dDRE","_Medidas"]

ref table dCalendario
ref table dLoja
ref table dProduto
ref table dFornecedor
ref table dCliente
ref table dCanal
ref table fVendas
ref table fItensVenda
ref table fEstoque
ref table fMetas
ref table fDespesas
ref table fRecebimentos
ref table fOrcamentoCompras
ref table fLotes
ref table fForecast
ref table fBacktest
ref table dCenario
ref table dDRE
ref table _Medidas

