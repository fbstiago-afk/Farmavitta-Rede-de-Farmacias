	partition fItensVenda = m
		mode: import
		source =
				let
				    Fonte = fnCsv("01_Dados_Originais\base_original\f_itens_venda.csv"),
				    Tipado = Table.TransformColumnTypes(Fonte, {{"id_item", type text}, {"id_venda", type text}, {"id_loja", type text}, {"id_produto", type text}, {"data_venda", type date}, {"quantidade", Int64.Type}, {"preco_unitario_bruto", type number}, {"taxa_desconto", type number}, {"valor_desconto", type number}, {"valor_liquido", type number}, {"custo_total", type number}}, "en-US"),
				    Cupom = Table.Buffer(Table.SelectColumns(fnCsv("01_Dados_Originais\base_original\f_vendas.csv"), {"id_venda", "canal", "id_cliente"})),
				    J = Table.NestedJoin(Tipado, "id_venda", Cupom, "id_venda", "v", JoinKind.LeftOuter),
				    E = Table.ExpandTableColumn(J, "v", {"canal", "id_cliente"}),
				    Anon = Table.ReplaceValue(E, "", "NI", Replacer.ReplaceValue, {"id_cliente"}),
				    Ultimo = Anon,
				    Final = Table.SelectColumns(Ultimo, {"id_item", "id_venda", "id_loja", "id_produto", "data_venda", "quantidade", "preco_unitario_bruto", "taxa_desconto", "valor_desconto", "valor_liquido", "custo_total", "canal", "id_cliente"})
				in
				    Final

	annotation PBI_ResultType = Table
