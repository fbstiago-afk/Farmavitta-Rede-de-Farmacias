/// Clientes sintéticos (22.000) + membro 'NI' para cupons anônimos. RFV é fotografia em 30/09/2026.
table dCliente
	lineageTag: 8152b18e-7a43-5e50-a53f-bca0c6ff5eaf

	column id_cliente
		dataType: string
