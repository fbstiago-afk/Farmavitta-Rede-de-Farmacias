		lineageTag: 2b1fc9af-4332-5c8f-9948-354974ae0508
		summarizeBy: none
		sourceColumn: primeira_compra

		annotation SummarizationSetBy = Automatic

	partition fVendas = m
		mode: import
		source =
				let
				    Fonte = fnCsv("01_Dados_Originais\base_original\f_vendas.csv"),
				    Tipado = Table.TransformColumnTypes(Fonte, {{"id_venda", type text}, {"data_venda", type date}, {"id_loja", type text}, {"id_cliente", type text}, {"canal", type text}, {"forma_pagamento", type text}, {"qtd_itens_distintos", Int64.Type}, {"valor_bruto", type number}, {"valor_desconto", type number}, {"valor_liquido", type number}, {"custo_mercadoria", type number}}, "en-US"),
				    Anon = Table.ReplaceValue(Tipado, "", "NI", Replacer.ReplaceValue, {"id_cliente"}),
				    Ident = Table.AddColumn(Anon, "cliente_identificado", each [id_cliente] <> "NI", type logical),
				    Rfv = Table.TransformColumnTypes(Table.SelectColumns(fnCsv("02_Dados_Tratados\d_cliente_rfv.csv"), {"id_cliente", "data_primeira_compra"}), {{"data_primeira_compra", type date}}, "en-US"),
				    J = Table.NestedJoin(Ident, "id_cliente", Rfv, "id_cliente", "r", JoinKind.LeftOuter),
				    E = Table.ExpandTableColumn(J, "r", {"data_primeira_compra"}),
				    Primeira = Table.AddColumn(E, "primeira_compra", each [data_primeira_compra] <> null and [data_venda] = [data_primeira_compra], type logical),
				    Ultimo = Primeira,
				    Final = Table.SelectColumns(Ultimo, {"id_venda", "data_venda", "id_loja", "id_cliente", "canal", "forma_pagamento", "qtd_itens_distintos", "valor_bruto", "valor_desconto", "valor_liquido", "custo_mercadoria", "cliente_identificado", "primeira_compra"})
				in
				    Final

	annotation PBI_ResultType = Table
