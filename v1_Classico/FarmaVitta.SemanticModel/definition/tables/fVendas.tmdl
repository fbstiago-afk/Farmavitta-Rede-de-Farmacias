/// Fato cupom (1 linha por venda). Fonte oficial de receita, desconto e CMV da rede.
table fVendas
	lineageTag: 117c5488-e491-595f-8d27-62411d75abb6

	column id_venda
		dataType: string
		isHidden
		lineageTag: c916df7d-e855-5ab0-b9ef-cca02830e6fd
		summarizeBy: none
		sourceColumn: id_venda

		annotation SummarizationSetBy = Automatic

	column data_venda
		dataType: dateTime
		formatString: dd/MM/yyyy
		isHidden
		lineageTag: f2086543-f1f3-584c-8b0e-b4252d25409d
		summarizeBy: none
		sourceColumn: data_venda

		annotation SummarizationSetBy = Automatic

		annotation UnderlyingDateTimeDataType = Date

