/// Fotografia de lotes em 30/09/2026 (simulada). Não é histórico: sem relação com calendário.
table fLotes
	lineageTag: e5e18255-8025-51e8-bc49-ee433e47ab94

	column id_lote
		dataType: string
		isHidden
		lineageTag: 47698221-2ef5-5d7f-a8fa-968c495ce693
		summarizeBy: none
		sourceColumn: id_lote

		annotation SummarizationSetBy = Automatic

	column id_loja
		dataType: string
		isHidden
		lineageTag: f4c0b9ac-5dfb-5f89-92ca-ced8934b7281
		summarizeBy: none
		sourceColumn: id_loja

		annotation SummarizationSetBy = Automatic

	column id_produto
		dataType: string
		isHidden
		lineageTag: d52070fe-59aa-500e-993b-c77a4fae2987
		summarizeBy: none
		sourceColumn: id_produto

		annotation SummarizationSetBy = Automatic

	column quantidade_lote
		dataType: int64
		isHidden
		lineageTag: d4dd1d2a-8b71-58c3-84ca-7733476dffe4
		summarizeBy: none
		sourceColumn: quantidade_lote

		annotation SummarizationSetBy = Automatic

	column 'Data Validade'
		dataType: dateTime
		formatString: dd/MM/yyyy
		lineageTag: be23aad4-bdd4-5910-942b-bb67236b34b8
		summarizeBy: none
		sourceColumn: data_validade_simulada

		annotation SummarizationSetBy = Automatic

		annotation UnderlyingDateTimeDataType = Date

	column 'Faixa Validade'
		dataType: string
		lineageTag: 87467c45-28b4-56af-95b9-d659cacb98a5
		summarizeBy: none
		sourceColumn: faixa_validade
		sortByColumn: 'Ordem Faixa'

		annotation SummarizationSetBy = Automatic

	column custo_unitario_referencia
		dataType: double
		isHidden
		lineageTag: 20275cb2-b477-55c3-b6fc-4b12fc41f434
		summarizeBy: none
		sourceColumn: custo_unitario_referencia

		annotation SummarizationSetBy = Automatic

	column valor_lote
		dataType: double
		isHidden
		lineageTag: 485b8271-7703-50a2-bc49-09b38ee482a9
		summarizeBy: none
		sourceColumn: valor_lote

		annotation SummarizationSetBy = Automatic

	column 'Ordem Faixa'
		dataType: int64
		isHidden
		lineageTag: 97d7cd33-67a7-50f1-9e21-094dc2cb6871
		summarizeBy: none
		sourceColumn: Ordem Faixa

		annotation SummarizationSetBy = Automatic

	partition fLotes = m
		mode: import
		source =
				let
				    Fonte = fnCsv("01_Dados_Originais\base_complementar\f_lotes_estoque_foto.csv"),
				    Tipado = Table.TransformColumnTypes(Fonte, {{"id_lote", type text}, {"id_loja", type text}, {"id_produto", type text}, {"quantidade_lote", Int64.Type}, {"data_validade_simulada", type date}, {"faixa_validade", type text}, {"custo_unitario_referencia", type number}}, "en-US"),
				    Valor = Table.AddColumn(Tipado, "valor_lote", each [quantidade_lote] * [custo_unitario_referencia], type number),
				    Ordem = Table.AddColumn(Valor, "Ordem Faixa", each if [faixa_validade] = "Vencido" then 1 else if [faixa_validade] = "Até 90 dias" then 2 else if [faixa_validade] = "91-180 dias" then 3 else 4, Int64.Type),
				    Ultimo = Ordem,
				    Final = Table.SelectColumns(Ultimo, {"id_lote", "id_loja", "id_produto", "quantidade_lote", "data_validade_simulada", "faixa_validade", "custo_unitario_referencia", "valor_lote", "Ordem Faixa"})
				in
				    Final

	annotation PBI_ResultType = Table
