{
  "name": "FarmaVitta",
  "dataColors": [
    "#18B89F",
    "#103D45",
    "#71858A",
    "#EF9277",
    "#125F61",
    "#8FD9C8",
    "#B7C4C7",
    "#F4C2B3",
    "#5C7C82",
    "#2E8C7E"
  ],
  "foreground": "#26383B",
  "foregroundNeutralSecondary": "#71858A",
  "background": "#FFFFFF",
  "backgroundLight": "#F7FAF9",
  "backgroundNeutral": "#E2ECE9",
  "tableAccent": "#18B89F",
  "good": "#0E8F7B",
  "neutral": "#EF9277",
  "bad": "#A34F39",
  "maximum": "#18B89F",
  "center": "#DDF5EB",
  "minimum": "#FFFFFF",
  "hyperlink": "#125F61",
  "textClasses": {
    "callout": {
      "fontSize": 24,
      "fontFace": "Segoe UI Semibold",
      "color": "#103D45"
    },
    "title": {
      "fontSize": 13,
      "fontFace": "Segoe UI Semibold",
      "color": "#103D45"
    },
    "header": {
      "fontSize": 12,
      "fontFace": "Segoe UI Semibold",
      "color": "#103D45"
    },
    "label": {
      "fontSize": 10,
      "fontFace": "Segoe UI",
      "color": "#26383B"
    }
  },
  "visualStyles": {
    "*": {
      "*": {
        "background": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#E2ECE9"
              }
            },
            "radius": 12,
            "width": 1
          }
        ],
        "dropShadow": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#103D45"
              }
            },
            "position": "Outer",
            "preset": "Custom",
            "shadowSpread": 0,
            "shadowBlur": 10,
            "angle": 90,
            "shadowDistance": 2,
            "transparency": 90
          }
        ],
        "title": [
          {
            "show": true,
            "fontColor": {
              "solid": {
                "color": "#103D45"
              }
            },
            "fontSize": 13,
            "fontFamily": "Segoe UI Semibold",
            "alignment": "left"
          }
        ],
        "padding": [
          {
            "top": 10,
            "bottom": 10,
            "left": 14,
            "right": 14
          }
        ],
        "visualTooltip": [
          {
            "fontSize": 10,
            "fontFamily": "Segoe UI"
          }
        ]
      }
    },
    "page": {
      "*": {
        "background": [
          {
            "color": {
              "solid": {
                "color": "#F7FAF9"
              }
            },
            "transparency": 0
          }
        ],
        "outspace": [
          {
            "color": {
              "solid": {
                "color": "#E6EEEC"
              }
            },
            "transparency": 0
          }
        ]
      }
    },
    "textbox": {
      "*": {
        "background": [
          {
            "show": false
          }
        ],
        "border": [
          {
            "show": false
          }
        ],
        "dropShadow": [
          {
            "show": false
          }
        ],
        "padding": [
          {
            "top": 0,
            "bottom": 0,
            "left": 0,
            "right": 0
          }
        ]
      }
    },
    "actionButton": {
      "*": {
        "background": [
          {
            "show": false
          }
        ],
        "border": [
          {
            "show": false
          }
        ],
        "dropShadow": [
          {
            "show": false
          }
        ]
      }
    },
    "slicer": {
      "*": {
        "dropShadow": [
          {
            "show": false
          }
        ],
        "border": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#E2ECE9"
              }
            },
            "radius": 8,
            "width": 1
          }
        ],
        "padding": [
          {
            "top": 4,
            "bottom": 4,
            "left": 10,
            "right": 10
          }
        ]
      }
    },
    "card": {
      "*": {
        "labels": [
          {
            "color": {
              "solid": {
                "color": "#103D45"
              }
            },
            "fontSize": 24,
            "fontFamily": "Segoe UI Semibold"
          }
        ],
        "categoryLabels": [
          {
            "show": false
          }
        ]
      }
    },
    "clusteredBarChart": {
      "*": {
        "labels": [
          {
            "show": true
          }
        ],
        "valueAxis": [
          {
            "show": false
          }
        ]
      }
    },
    "clusteredColumnChart": {
      "*": {
        "labels": [
          {
            "show": true
          }
        ],
        "valueAxis": [
          {
            "show": false
          }
        ]
      }
    },
    "tableEx": {
      "*": {
        "columnHeaders": [
          {
            "fontColor": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "backColor": {
              "solid": {
                "color": "#103D45"
              }
            },
            "fontFamily": "Segoe UI Semibold"
          }
        ],
        "values": [
          {
            "backColorSecondary": {
              "solid": {
                "color": "#F4FAF8"
              }
            }
          }
        ]
      }
    },
    "pivotTable": {
      "*": {
        "columnHeaders": [
          {
            "fontColor": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "backColor": {
              "solid": {
                "color": "#103D45"
              }
            },
            "fontFamily": "Segoe UI Semibold"
          }
        ]
      }
    }
  }
}